mixin table-tree(items,level=1)
  each item,index in items 
    - const prefix = Array(level+1).join("-- ")
    tr
        td 
            input(
                type="checkbox"
                name="id"
                value=item.id 
            )
        td #{item.index}
        td
            img(
                src=item.thumbnail 
                alt=item.title 
                width="100px"
                height="auto"
            )
        td #{prefix}#{item.title} 
        td 
            input(
                type="number"
                value=item.position 
                style="width: 60px"
                min="1"
                name="position"
            )
        td 
            if(role.permissions.includes("products-category_edit"))
                if(item.status == "active")
                    a(
                    href="javascript:;"
                    data-status = "active"
                    data-id = item.id 
                    button-change-status
                    class="btn btn-success"
                    ) Hoạt động
                else 
                    a(
                    href="javascript:;"
                    data-status = "inactive"
                    data-id = item.id 
                    button-change-status
                    class="btn btn-danger"
                    ) Dừng hoạt động
            else
                if(item.status == "active")
                    a(
                    class="btn btn-success"
                    ) Hoạt động
                else 
                    a(
                    class="btn btn-danger"
                    ) Dừng hoạt động
        td
            
            a(href=`/admin/products-category/detail/${item.id}`
            class="btn btn-secondary"
            ) Chi tiết

            if(role.permissions.includes("products-category_edit"))
                a(href=`/admin/products-category/edit/${item.id}`
                class="btn btn-warning"
                ) Sửa
            if(role.permissions.includes("products-category_delete"))
                button(
                    class="btn btn-danger"
                    button-delete 
                    data-id = item.id 
                ) Xóa

    if item.children && item.children.length > 0
        +table-tree(item.children,level+1) 
