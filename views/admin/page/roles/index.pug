extends ../../layout/default.pug

block main
  - if (messages.success)
    .message.info
      div(
        class="alert alert-success"
        show-alert
        data-time="5000"
      ) #{messages.success}

  h1(class="mb-4") Nhóm quyền

  .card.mb-3
    .card-header Danh sách
    .card-body
      .row
        .col-8
        .col-4.text-right
          if(role.permissions.includes("role_create"))
            a(
              href="/admin/roles/create"
              class="btn btn-outline-success"
            ) + Thêm mới
  
  table(class="table table-hover table-sm")
    thead
      tr
        th STT
        th Nhóm quyền
        th Mô tả ngắn
        th Hành động
    tbody
      if (records.length > 0)
        each item, index in records
          tr
            td #{index + 1}
            td #{item.title}
            td #{item.description}
            td
              a(
                class="btn btn-secondary btn-sm"
                href=`/admin/roles/detail/${item.id}`
              ) Chi tiết
              if(role.permissions.includes("role_edit"))
                a(
                  class="btn btn-warning btn-sm ml-1"
                  href=`/admin/roles/edit/${item.id}`
                ) Sửa
              if(role.permissions.includes("role_delete"))
                button(
                  button-delete 
                  data-id = item.id
                  class="btn btn-danger btn-sm ml-1"
                ) Xóa
      else
        tr
          td(colspan="4" class="text-center") Chưa có nhóm quyền nào được tạo.

  form(
    action="",
    method="POST"
    id= "form-delete-item"
    data-path = "/admin/roles/delete" 
  ) 


  script(src="/admin/js/products.js")  