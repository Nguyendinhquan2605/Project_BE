extends ../../layout/default.pug

block main

  h1(class="mb-4") Chỉnh sửa tài khoản
  - if (messages.error)
      .message.info
        div(
          class="alert alert-danger"
          show-alert
          data-time="3000"
        ) #{messages.error}

  - if (messages.success)
      .message.info
        div(
          class="alert alert-success"
          show-alert
          data-time="3000"
        ) #{messages.success}
  if(roles)
    form(
        action=`/admin/accounts/edit/${data.id}?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
        label(for="fullname") Họ tên *
        input(
            type="text"
            class="form-control"
            id="fullname"
            name="fullname"
            value=data.fullname
        )
        div(class="form-group")
        label(for="email") Email *
        input(
            type="email"
            class="form-control"
            id="email"
            name="email"
            value=data.email
        )
        div(class="form-group")
        label(for="password") Mật khẩu *
        input(
            type="password"
            class="form-control"
            id="password"
            name="password"
        )
        div(class="form-group")
        label(for="phone") Số điện thoại *
        input(
            type="phone"
            class="form-control"
            id="phone"
            name="phone"
            value=data.phone
        )

        br

        div(
            class="form-group"
            upload-image
        )
        label(for="avatar") Avatar *
        input(
            type="file"
            class="form-control-file"
            id="avatar"
            name="avatar"
            accept="image/*"
            upload-image-input
        )
        img(
            src=data.avatar,
            class="image-preview"
            upload-image-preview 
            )
        
        br

        div(class="form-group")
            label(for="role_id") Phân quyền
            select(name="role_id" id="role_id" class="form-control")
                option(disabled) -- Chọn --
                each items in roles 
                    option(
                        value=items.id,
                        selected=(items.id == data.role_id? true : false)
                    ) #{items.title}

        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked=(data.status === "active" ? true : false)
            )
            label(for="statusActive" class="form-check-label") Hoạt động
        
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusInActive"
                name="status"
                value="inactive"
                checked=(data.status === "inactive" ? true : false)
            )
            label(for="statusActive" class="form-check-label") Dừng Hoạt động
        
        br

        div(class="form-group")
        button(
            type="submit"
            class="btn btn-primary"
        ) Tạo mới

  else
    p Vui lòng tạo nhóm quyền trước khi cập nhật tài khoản
    p
        a(
        href=`/admin/roles/create`
        class="btn btn-secondary"
        ) Tạo nhóm quyền  

