extends ../../layout/default.pug

block main

  h1(class="mb-4") Danh sách tài khoản

  .card.mb-3
    .card-header Danh sách
    .card-body
      .row
        .col-8
        .col-4.text-right
          a(
            href=`/admin/accounts/create`
            class="btn btn-outline-success"
          ) + Thêm mới
      
      br

      table(
        class="table table-hover table-sm"
      )
        thead
          tr
            th STT
            th Avatar
            th Họ tên
            th Phân quyền
            th Email
            th Trạng thái
            th Hành động

        tbody 
          each items,index  in records 
            tr 
              td #{index + 1}
              td 
                img(
                  src=items.avatar,
                  alt=items.fullname ,
                  width="100px"
                  height="auto"
                )
              td #{items.fullname}
              td #{items.role.title}
              td #{items.email}
              td
                if (items.status === "active")
                  a(
                    href="javascript:;"
                    class="btn btn-success"
                    data-status="active"
                  ) Hoạt động
                else
                  a(
                    href="javascript:;"
                    class="btn btn-danger"
                    data-status="inactive"
                  ) Dừng hoạt động
              
              td
                a(
                  class="btn btn-secondary btn-sm"
                  href=`admin/accounts/detail/${items.id}`
                ) Chi tiết
                a(
                  class="btn btn-warning btn-sm ml-1"
                  href=`/admin/accounts/edit/${items.id}`
                ) Sửa
                button(
                  class="btn btn-danger btn-sm ml-1"
                ) Xóa

  
  