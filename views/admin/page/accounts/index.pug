extends ../../layout/default.pug

block main
  - if (messages.success)
    .message.info
      div(
        class="alert alert-success"
        show-alert
        data-time="5000"
      ) #{messages.success}

  h1(class="mb-4") Danh sách tài khoản

  .card.mb-3
    .card-header Danh sách
    .card-body
      .row
        .col-8
        .col-4.text-right
          if(role.permissions.includes("account_create"))
            a(
              href=`/admin/accounts/create`
              class="btn btn-outline-success"
            ) + Thêm mới
      
      br

      table(
        class="table table-hover table-sm"
      )
        thead
          tr
            th STT
            th Avatar
            th Họ tên
            th Phân quyền
            th Email
            th Trạng thái
            th Hành động

        tbody 
          each items,index  in records 
            tr 
              td #{index + 1}
              td 
                img(
                  src=items.avatar,
                  alt=items.fullname ,
                  width="100px"
                  height="auto"
                )
              td #{items.fullname}
              td #{items.role.title}
              td #{items.email}
              td
                if(role.permissions.includes("account_edit"))
                  if (items.status === "active")
                    a(
                      href="javascript:;"
                      class="btn btn-success"
                      data-status="active"
                      data-id = items.id 
                      button-change-status
                    ) Hoạt động
                  else
                    a(
                      href="javascript:;"
                      class="btn btn-danger"
                      data-status="inactive"
                      data-id = items.id 
                      button-change-status
                    ) Dừng hoạt động
                else 
                  if (items.status === "active")
                    a(                     
                      class="btn btn-success"                     
                    ) Hoạt động
                  else
                    a(                     
                      class="btn btn-danger"                      
                    ) Dừng hoạt động
              
              td
                a(
                  class="btn btn-secondary btn-sm"
                  href=`/admin/accounts/detail/${items.id}`
                ) Chi tiết
                if(role.permissions.includes("account_edit"))
                  a(
                    class="btn btn-warning btn-sm ml-1"
                    href=`/admin/accounts/edit/${items.id}`
                  ) Sửa
                if(role.permissions.includes("account_delete"))
                  button(
                    button-delete 
                    data-id = items.id 
                    class="btn btn-danger btn-sm ml-1"
                  ) Xóa

  form(
    action="",
    method="POST"
    id= "form-change-status"
    data-path = "/admin/accounts/change-status" 
  )

  form(
    action="",
    method="POST"
    id= "form-delete-item"
    data-path = "/admin/accounts/delete" 
  ) 
  
  script(src="/admin/js/products.js") 
  
  