extends ../../layout/default.pug

block main

  if (data.title)
    h1(class="mb-4 tieude") #{data.title}

  if (data.thumbnail)
    div(class="mb-4 anh")
      img(
        src=data.thumbnail
        style="width: 100px"
      )

  if (data.status)
    div(class="mb-4 trangthai")
        span Trạng thái:
        if (data.status === "active")
          span(class="badge bg-success") Hoạt động
        else
          span(class="badge bg-danger") Dừng hoạt động

  if (data.position)
    div(class="mb-4 vitri") Vị trí: <b>#{data.position}</b>

  if (data.description)
    div(class="mb-4 mota") !{data.description}

  a(
    href=`/admin/products-category/edit/${data.id}`,
    class="btn btn-warning"
    ) Chỉnh sửa

  script(src="/admin/js/products.js") 