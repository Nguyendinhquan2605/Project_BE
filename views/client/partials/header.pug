include ../mixins/sub_Menu.pug

header.header
  .container
    .header-wrapper
      .header-logo
        .inner-logo
          a(href="/")
            img(src="/img/logo.svg", alt="Logo")

      .header-search
        form(action="/search", method="GET")
          div(class="form-group d-flex mb-0")
            input(
              type="text"
              placeholder="Nhập từ khóa..."
              class="form-control"
              name="keyword"
              value=keyword
            )
            button(type="submit", class="btn btn-primary") Tìm

      .header-menu
        .inner-menu
          ul
            li
              a(href="/") Trang chủ
            li(class="sub-menu")
              -const pathProduct = "/products"
              a(href=pathProduct) Sản phẩm
              +sub-menu(layout_ProductsCategory,pathProduct)
            li 
              a(href="/cart") Giỏ hàng (#{miniCart ?  miniCart.totalQuantity : "0"})
            li 
              button(class="btn btn-login")
                a(href="/user/login") Đăng nhập
            li 
              button(class="btn btn-register")
                a(href="/user/register") Đăng ký