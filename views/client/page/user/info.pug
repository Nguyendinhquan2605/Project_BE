extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head("Thông tin tài khoản")
        
        .card.mb-4
          .card-body
            .row.mb-3
              .col-md-3.fw-bold Họ và tên:
              .col-md-9 #{user.fullName}
            
            .row.mb-3
              .col-md-3.fw-bold Email:
              .col-md-9 #{user.email}
            
            .row.mb-3
              .col-md-3.fw-bold Trạng thái:
              .col-md-9
                if user.status === 'active'
                  span.badge.bg-success Hoạt động
                else if user.status === 'inactive'
                  span.badge.bg-warning Dừng hoạt động
                //- else
                //-   span.badge.bg-secondary #{user.status}
            
            .row.mt-4
              .col-12
                a.btn.btn-primary(href="/account/edit") Chỉnh sửa thông tin