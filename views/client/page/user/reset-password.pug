extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)

  .container.my-5
    .row.justify-content-center
      .col-8
        h1(class="text-center") Cập nhật mật khẩu
        form(action="/user/password/reset", method="POST")
          div(class="form-group")
            label(for="password") Mật khẩu mới
            input(
              type="password"
              class="form-control"
              id="newpassword"
              name="newpassword"
              required
            )
          div(class="form-group")
            label(for="repassword") Xác nhận mật khẩu
            input(
              type="password"
              class="form-control"
              id="repassword"
              name="repassword"
              required
            )
          button(type="submit", class="btn btn-primary btn-block") Xác nhận